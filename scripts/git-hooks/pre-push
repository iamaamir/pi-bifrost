#!/bin/sh
# Pre-push gate: run the quick tier (typecheck + fast tests) and the fast
# quality gates, so a broken tree, dead rule scope, or stale complexity
# baseline rarely reaches CI. Bypass with `git push --no-verify`; enable per
# clone with: git config core.hooksPath scripts/git-hooks
# Skip silently outside a prepared tree (fresh clone, CI, no node_modules).
[ -d node_modules ] || exit 0
# Hooks inherit GIT_DIR/GIT_WORK_TREE; child processes (tests that shell out to
# git) would then target this repo instead of their own fixtures. Drop them so
# the quick tier runs exactly as it does from a terminal.
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_COMMON_DIR
npm run test:quick || exit 1
npm run check:ast || exit 1
npm run check:duplication || exit 1
exec npm run check:complexity
