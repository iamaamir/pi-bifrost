{
  "threshold": 3.3,
  "minLines": 10,
  "minTokens": 50,
  "format": ["typescript", "javascript"],
  "ignore": [
    "**/node_modules/**",
    "**/dist/**",
    "**/coverage/**",
    "**/reports/**",
    "**/.git/**",
    "**/.worktrees/**",
    "**/.commandcode/**",
    "**/package-lock.json",
    "**/screenshots/**",
    "**/evidence/**",
    "**/.pi/**"
  ],
  "reporters": ["console"],
  "gitignore": true,
  "absolute": false
}
