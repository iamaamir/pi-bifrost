  {
    "pattern": "\\b(schema|migration|query|transaction|index)\\b",
    "model": "backend"
  },
  {
    "pattern": "\\b(deploy|docker|terraform|kubernetes|pipeline)\\b",
    "model": "infrastructure"
  }
]
