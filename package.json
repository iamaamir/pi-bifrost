{
  "name": "pi-bifrost",
  "version": "0.1.4",
  "description": "Query-aware model router for pi — inspects each prompt and switches to the best available model automatically.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Aamir",
    "url": "https://github.com/iamaamir"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamaamir/pi-bifrost"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "model-router",
    "llm",
    "ai",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "minPiVersion": "0.80.8"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/cache.test.ts tests/classifier.test.ts tests/routing.test.ts tests/pipeline.test.ts tests/commands.test.ts",
    "test:integration": "cd .. && node --test pi-bifrost/tests/integration.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
