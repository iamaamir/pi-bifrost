{
  "name": "pi-bifrost",
  "version": "0.2.0",
  "description": "Query-aware model routing extension for Pi. Select models by task complexity, cost, context, speed, or configured order.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Aamir",
    "url": "https://github.com/iamaamir"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/iamaamir/pi-bifrost"
  },
  "homepage": "https://iamaamir.github.io/pi-bifrost/",
  "bugs": {
    "url": "https://github.com/iamaamir/pi-bifrost/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "model-router",
    "model-routing",
    "developer-tools",
    "llm",
    "ai",
    "coding-agent"
  ],
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "minPiVersion": "0.80.8",
    "image": "https://iamaamir.github.io/pi-bifrost/social-card.png"
  },
  "scripts": {
    "test": "node --test --experimental-strip-types tests/cache.test.ts tests/classifier.test.ts tests/routing.test.ts tests/pipeline.test.ts tests/commands.test.ts tests/inline-override.test.ts tests/config.test.ts tests/probe.test.ts tests/ux-status.test.ts",
    "test:integration": "cd .. && node --test pi-bifrost/tests/integration.test.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@types/node": "^26.1.1"
  }
}
